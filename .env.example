# Ključ za Claude API (Anthropic Console -> API Keys).
# Brez tega aplikacija še vedno deluje, a uporabi vgrajena vprašanja.
ANTHROPIC_API_KEY=sk-ant-...

# Geslo za velik zaslon. NUJNO nastavi, če je aplikacija na spletu -
# brez njega lahko kdorkoli odpre igro in porabi tvoje kredite.
HOST_PASSWORD=

# Kam se shranjujejo kvizi in zgodovina iger
CKVIZ_DATA_DIR=./data

# Javni naslov, če ga strežnik sam ne zazna pravilno (za QR kodo)
# PUBLIC_URL=https://ckviz.example.com

PORT=3000
# CKVIZ_MODEL=claude-opus-5
# CKVIZ_FALLBACK_MODEL=claude-opus-4-8
# CKVIZ_EFFORT=medium        # low | medium | high | xhigh | max
